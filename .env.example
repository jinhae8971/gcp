# KOSPI Intel Dashboard — 환경 변수
# 이 파일을 .env로 복사하여 사용 (.env는 git에 커밋되지 않음)
#   cp .env.example .env

# (선택) KRX 정보데이터시스템 자격증명
# 입력 시 pykrx가 풀데이터 사용 (외인/기관 종목별 정확한 수급, 시총 가중 섹터)
# 미입력 시 Naver Finance 폴백 (등락률/거래대금/시세는 정확, 외인 수급은 추정값)
# 가입: https://data.krx.co.kr
KRX_ID=
KRX_PW=

# (선택) Anthropic API key
# Dashboard Settings(⚙)에서도 입력 가능
# 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
